# Bolna API. Leave empty to run the seeded demo without outbound calls.
BOLNA_API_KEY=
BOLNA_AGENT_ID_CLOSE=
BOLNA_AGENT_ID_OPEN=
BOLNA_AGENT_ID_ALERT=
BOLNA_BASE_URL=https://api.bolna.ai

# Public HTTPS origin for the deployed Vercel app.
PUBLIC_BASE_URL=http://localhost:8000

# Local SQLite is for development only. Vercel requires a persistent PostgreSQL URL.
DATABASE_URL=sqlite:///./karkhana.db

# Callback authentication. Configure X-Webhook-Secret with this value in Bolna.
WEBHOOK_SECRET=
TOOL_TOKEN=
CRON_SECRET=
ENFORCE_BOLNA_IP_ALLOWLIST=false

# Demo call safety
DEMO_DAILY_CAP=20
DEMO_PER_PHONE_DAILY_CAP=2
WALLET_FLOOR=1.0
DEMO_ESCALATION_SECONDS=60
OPEN_BRIEF_TIME=08:00
TEST_RECIPIENT_PHONE=

# Optional parser provider settings. Deterministic confirmation-line parsing
# is used by default; no model/provider is assumed.
PARSER_PROVIDER=
PARSER_MODEL=
PARSER_API_KEY=

DEFAULT_ORG_ID=org_aarav_pumps
PROMPT_VERSION_CLOSE=close-v1.0
